{
  "name": "judo-manager",
  "version": "1.0.0",
  "productName": "JudoManager Pro",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron:dev": "set ELECTRON_DEV=true && electron .",
    "build:exe": "npm run build && node build-scripts/prepare-standalone.js && electron-builder --win --x64"
  },
  "dependencies": {
    "mongodb": "^7.5.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "com.judomanager.pro",
    "productName": "JudoManager Pro",
    "copyright": "© 2026 JudoManager Pro",
    "asar": false,
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "electron-app-bundle",
        "to": "app",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JudoManager Pro",
      "installerLanguages": [
        "ar"
      ],
      "unicode": true
    },
    "directories": {
      "output": "dist-exe"
    }
  }
}
