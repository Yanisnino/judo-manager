{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/dashboard/athletes/[id]",
      "regex": "^/dashboard/athletes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/athletes/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/qr/[code]",
      "regex": "^/qr/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcode": "nxtPcode"
      },
      "namedRegex": "^/qr/(?<nxtPcode>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/activate",
      "regex": "^/activate(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/activate(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/athlete",
      "regex": "^/athlete(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/athlete(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/athletes",
      "regex": "^/dashboard/athletes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/athletes(?:/)?$"
    },
    {
      "page": "/dashboard/attendance",
      "regex": "^/dashboard/attendance(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/attendance(?:/)?$"
    },
    {
      "page": "/dashboard/backup",
      "regex": "^/dashboard/backup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/backup(?:/)?$"
    },
    {
      "page": "/dashboard/belts",
      "regex": "^/dashboard/belts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/belts(?:/)?$"
    },
    {
      "page": "/dashboard/notifications",
      "regex": "^/dashboard/notifications(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/notifications(?:/)?$"
    },
    {
      "page": "/dashboard/settings",
      "regex": "^/dashboard/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/settings(?:/)?$"
    },
    {
      "page": "/dashboard/subscriptions",
      "regex": "^/dashboard/subscriptions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/subscriptions(?:/)?$"
    },
    {
      "page": "/developer",
      "regex": "^/developer(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/developer(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/install",
      "regex": "^/install(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/install(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/parent",
      "regex": "^/parent(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/parent(?:/)?$"
    },
    {
      "page": "/register",
      "regex": "^/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/register(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": []
